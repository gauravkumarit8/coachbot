# Copy to .env and fill in. Never commit .env
# AI provider: groq (default) or anthropic
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_...
# Optional: speed/cost of reasoning models (low|medium|high). Leave blank for the default.
# GROQ_REASONING_EFFORT=low
# Only if LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# Meta (WhatsApp Cloud API + Instagram/Facebook)
VERIFY_TOKEN=pick-any-long-random-string
META_APP_SECRET=from-meta-app-dashboard
WHATSAPP_TOKEN=permanent-system-user-token
META_PAGE_TOKEN=page-access-token

ADMIN_TOKEN=gaurav123chatbot123awsedrf

# Per-institute secrets for the BSP route (names are referenced from each institute's config.json)
# ACME_WA_KEY=api-key-from-the-institutes-bsp-account
# ACME_WEBHOOK_KEY=long-random-string-you-put-in-the-webhook-url

# Owner page key for each institute (config.json "owner_key_env"), at least 12 characters. Open /owner/<id>
DEMO_OWNER_KEY=choose-a-long-random-phrase

# How many recent chat messages the bot re-reads on every reply (fewer = cheaper and faster)
# HISTORY_MESSAGES=12

# Which websites may show the chat: your own address plus each institute's website. Unset = every site (testing only).
# CORS_ORIGINS=https://coachbot.example.com,https://www.some-institute.com

# Public chat protection. Only set TRUST_PROXY when a tunnel or web server really sits in front, so each visitor's real address is used:
#   TRUST_PROXY=1     a Cloudflare tunnel (cloudflared)
#   TRUST_PROXY=xff   your own nginx/Caddy or Render; also set PROXY_HOPS (1 for nginx/Caddy, 2 for Render) and check with /admin/whoami
# TRUST_PROXY=xff
# PROXY_HOPS=1
# CHAT_IP_PER_MIN=20
# CHAT_DAILY_CAP=2000

# Owner alerts without WhatsApp. Telegram: create a bot with @BotFather and put its token here. Email: any SMTP account.
# TELEGRAM_BOT_TOKEN=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Automatic cleanup (runs once a day). Days to keep chat messages and leads; 0 = keep forever.
# Per institute you can override with "retention_days" and "lead_retention_days" in config.json.
# RETENTION_DAYS=180
# LEAD_RETENTION_DAYS=365

# Hourly background checker (daily cleanup + Monday weekly summaries). 0 switches it off.
# COACHBOT_BACKGROUND_JOBS=1
# Owners are in India: times and "midnight" use UTC+5:30. Minutes from UTC; change only if needed.
# COACHBOT_UTC_OFFSET_MIN=330

# Where the institutes and the database live. Leave unset on your own PC. On Render they point at the persistent disk (set by render.yaml).
# COACHBOT_INSTITUTES_DIR=/data/institutes
# COACHBOT_ENV_FILE=/data/extra.env
